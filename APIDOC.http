#==========================ACCOUNTS========================
#api call for adding user
###
POST http://127.0.0.1:8000/account/register/
Content-Type: application/json

{
    "username":"django",
    "email":"django@gmail.com",
    "password":"password@123",
    "phone":"4567823",
    "dob":"2004-01-25"
}


#========================EXPENSE==========================
#api call for listing all expenses
###
GET http://127.0.0.1:8000/expenses/
Accept: application/json
Authorization: Basic django:password@123


#api call for adding expenses
###
POST http://127.0.0.1:8000/expenses/
Content-Type: application/json
Authorization: Basic django:password@123

{
    "title":"snacks",
    "amount":270,
    "category":"food"
}
